{
    "name": "algorithme-tn",
    "displayName": "Algorithme-tn",
    "description": "Pseudocode conforme aux programmes du lycée en Tunisie",
    "version": "0.0.6",
    "icon": "images/icon.png",
    "engines": {
        "vscode": "^1.38.0"
    },
    "publisher": "les-profs-d-info",
    "categories": [
        "Programming Languages"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:algo"
    ],
    "contributes": {
        "commands": [
            {
                "command": "algo.run",
                "title": "Exécuter l'algorithme",
                "category": "Algorithme",
                "icon": "$(play)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "algo.run",
                    "when": "editorLangId == algo",
                    "group": "navigation"
                }
            ],
            "editor/context": [
                {
                    "command": "algo.run",
                    "when": "editorLangId == algo",
                    "group": "algo@1"
                }
            ]
        },
        "keybindings": [
            {
                "command": "algo.run",
                "key": "ctrl+f5",
                "when": "editorLangId == algo"
            }
        ],
        "configuration": {
            "title": "Algorithme-tn",
            "properties": {
                "algo.pythonPath": {
                    "type": "string",
                    "default": "python",
                    "description": "Interpréteur Python utilisé pour exécuter les fichiers .algo (ex : python, python3, py)."
                }
            }
        },
        "languages": [
            {
                "id": "algo",
                "aliases": [
                    "Algorithme en Pseudocode",
                    "algo"
                ],
                "extensions": [
                    ".algo",
                    ".alg"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "algo",
                "scopeName": "source.algo",
                "path": "./syntaxes/algo.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.embedded.block.python": "python",
                    "meta.embedded.block.javascript": "javascript"
                }
            }
        ],
        "snippets": [
            {
                "language": "algo",
                "path": "./snippets/base.json"
            },
            {
                "language": "algo",
                "path": "./snippets/x-snippets.json"
            }
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/romoez/algo-tn-vscode.git"
    }
}
